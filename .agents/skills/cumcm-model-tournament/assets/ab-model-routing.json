{
  "schema_version": "1.0.0",
  "catalog_id": "cumcm-ab-archetype-routing",
  "scope": {
    "contest": "CUMCM",
    "problem_letters": ["A", "B"],
    "quality_target": "national_first_candidate",
    "calibration_years": [2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025],
    "routing_keys": [
      "research_object",
      "state_evolution",
      "observation_structure",
      "decision_variables",
      "constraints",
      "uncertainty",
      "required_deliverable"
    ],
    "routing_key_excludes": ["problem_letter", "algorithm_popularity", "paper_length"],
    "same_problem_answer_leakage_forbidden": true
  },
  "selection_policy": {
    "principle": "minimum_sufficient_method",
    "priority_order": [
      "analytic_or_direct",
      "complete_enumeration_or_exact_small_algorithm",
      "classical_statistical_or_deterministic_optimization",
      "complex_nonlinear_or_stochastic_search",
      "machine_learning_or_neural_model_when_data_and_validation_require"
    ],
    "simple_method_wins_when": [
      "all_frozen_hard_thresholds_pass",
      "question_deliverables_are_complete",
      "independent_validation_passes",
      "difference_from_complex_candidate_is_within_numerical_or_sampling_uncertainty"
    ],
    "complexity_upgrade_requires": [
      "named_simple_candidate_failure_on_predeclared_metric",
      "complex_candidate_fixes_that_failure",
      "independent_validation_gain_exceeds_uncertainty",
      "additional_complexity_risks_are_checked",
      "parameters_stopping_rules_and_reproduction_cost_are_recorded"
    ],
    "algorithm_label_has_no_score": true
  },
  "candidate_roles": ["baseline", "main_candidate", "heterogeneous_challenge", "fallback"],
  "claim_levels": {
    "L4_exact_global": {
      "allowed_claims": ["exact_global_optimum"],
      "minimum_evidence": [
        "complete_enumeration_or_mathematical_proof",
        "convex_duality_certificate_or_branch_and_bound_gap",
        "feasibility_recheck",
        "numerical_tolerance_report"
      ]
    },
    "L3_certified": {
      "allowed_claims": ["certified_near_optimal", "simultaneously_certified_feasible"],
      "minimum_evidence": [
        "valid_bound_or_simultaneous_probability_guarantee",
        "closed_error_budget",
        "independent_recheck"
      ]
    },
    "L2_best_known": {
      "allowed_claims": ["best_known", "near_optimal_candidate"],
      "minimum_evidence": [
        "multiple_initializations_or_methods",
        "expanded_neighborhood_or_candidate_pool",
        "small_instance_calibration",
        "stopping_rule_and_feasibility_recheck"
      ]
    },
    "L1_estimate": {
      "allowed_claims": ["estimate", "simulation_result", "exploratory_trend"],
      "minimum_evidence": [
        "reproducible_estimator",
        "uncertainty_or_error_report",
        "scope_and_limitations"
      ]
    }
  },
  "algorithm_contracts": {
    "adaptive_ode": {
      "use_when": ["continuous_state_dynamics", "initial_value_problem"],
      "required_evidence": [
        "relative_tolerance",
        "absolute_tolerance",
        "maximum_step",
        "event_handling",
        "independent_integrator_or_analytic_case"
      ],
      "claim_limit": "numerical_solution_with_reported_discretization_error"
    },
    "pde_discretization": {
      "use_when": ["spatial_field", "conservation_or_transport_law"],
      "required_evidence": [
        "boundary_discretization",
        "mesh_refinement",
        "time_step_refinement_if_applicable",
        "conservation_residual",
        "solver_tolerance"
      ],
      "claim_limit": "field_solution_with_mesh_and_model_error_budget"
    },
    "nonlinear_inverse": {
      "use_when": ["indirect_observation", "unknown_physical_parameter"],
      "required_evidence": [
        "synthetic_parameter_recovery",
        "multiple_initializations",
        "profile_likelihood_or_equivalent_identifiability_check",
        "residual_structure",
        "measurement_error_propagation"
      ],
      "claim_limit": "identified_parameter_or_supported_interval"
    },
    "statistical_learning": {
      "use_when": ["labeled_or_response_data", "enough_independent_samples"],
      "required_evidence": [
        "leakage_safe_split",
        "simple_baseline",
        "frozen_validation_metric",
        "calibration_or_residual_diagnostics",
        "complexity_ablation"
      ],
      "claim_limit": "held_out_performance_with_declared_population_scope"
    },
    "exact_or_certified_optimization": {
      "use_when": ["explicit_decision_variables", "explicit_objective", "explicit_constraints"],
      "required_evidence": [
        "feasible_incumbent",
        "best_bound_or_proof",
        "optimality_gap",
        "constraint_residuals",
        "solver_status_and_tolerances"
      ],
      "claim_limit": "L4_exact_global_or_L3_certified"
    },
    "local_nonlinear_optimization": {
      "use_when": ["smooth_continuous_variables", "nonconvexity_possible"],
      "required_evidence": [
        "variable_scaling",
        "constraint_handling",
        "multiple_initializations",
        "gradient_or_finite_difference_check",
        "local_refinement_and_feasibility_recheck"
      ],
      "claim_limit": "L2_best_known_unless_global_certificate_exists"
    },
    "metaheuristic_search": {
      "use_when": ["complex_nonconvex_or_combinatorial_search", "exact_route_intractable_within_budget"],
      "required_evidence": [
        "encoding_and_repair_rule",
        "population_or_temperature_settings",
        "multiple_seed_distribution",
        "explicit_stopping_rule",
        "local_refinement",
        "small_instance_exact_calibration",
        "expanded_search_space_check"
      ],
      "claim_limit": "L2_best_known"
    },
    "monte_carlo": {
      "use_when": ["explicit_random_source", "uncertainty_propagation_or_probability_estimation"],
      "required_evidence": [
        "uncertainty_source",
        "sampling_plan",
        "sample_size_rationale",
        "seed_policy",
        "interval_method",
        "variance_or_effective_sample_size",
        "stopping_rule",
        "multiplicity_control_for_multi_candidate_selection",
        "independent_confirmation_for_adaptive_selection"
      ],
      "claim_limit": "L3_certified_only_with_valid_simultaneous_control_otherwise_L1_estimate"
    },
    "multi_criteria_evaluation": {
      "use_when": ["question_explicitly_requires_composite_evaluation_or_ranking"],
      "required_evidence": [
        "indicator_semantics_and_direction",
        "dimension_and_redundancy_check",
        "weight_source",
        "alternative_normalization",
        "weight_perturbation",
        "rank_stability_or_rank_interval"
      ],
      "claim_limit": "ranking_under_declared_value_system"
    }
  },
  "archetypes": [
